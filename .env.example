# Supabase Auth is shared across portfolio subdomains. Configure Google as a provider in Supabase.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Configure this in production so niranjanreddy.tech and its subdomains share the session cookie.
SUPABASE_COOKIE_DOMAIN=.niranjanreddy.tech

# MusicKit key from your Apple Developer account. Keep the .p8 private key in .env.local or hosting secrets.
APPLE_MUSIC_TEAM_ID=
APPLE_MUSIC_KEY_ID=
APPLE_MUSIC_PRIVATE_KEY_BASE64=
APPLE_MUSIC_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3031,https://moodify.niranjanreddy.tech

# MoneyFlow private workspace. Keep values in .env.local or deployment secrets.
DATABASE_URL=file:./moneyflow.db
# For hosted SQLite, set both variables below; the app uses them instead of the local file.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
MONEYFLOW_ALLOWED_EMAIL=
MONEYFLOW_PUBLIC_ORIGIN=
