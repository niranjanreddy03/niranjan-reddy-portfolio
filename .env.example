# MusicKit key from your Apple Developer account. Keep the .p8 private key in .env.local or hosting secrets.
APPLE_MUSIC_TEAM_ID=
APPLE_MUSIC_KEY_ID=
APPLE_MUSIC_PRIVATE_KEY_BASE64=
APPLE_MUSIC_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3031,https://moodify.niranjanreddy.tech

# MoneyFlow private workspace. Keep values in .env.local or deployment secrets.
DATABASE_URL=file:./moneyflow.db
MONEYFLOW_AUTH_SECRET=
MONEYFLOW_ALLOWED_EMAIL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Add http://localhost:3032/api/moneyflow/auth/google/callback (or your live origin)
# as an authorized Google OAuth redirect URI.
